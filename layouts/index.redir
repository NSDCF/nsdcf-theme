# Netlify redirects. See https://www.netlify.com/docs/redirects/
{{  range $p := .Site.Pages -}}
  {{ range .Aliases }}
    {{  . | printf "%-35s" }}	{{ $p.RelPermalink -}}
  {{ end -}}
{{- end -}}
{{ with hugo.Data.redirects }}
  {{ range .redirects }}
    {{  .oldURL | printf "%-35s" }}	{{ .newURL -}}
  {{- end -}}
{{- end -}}
